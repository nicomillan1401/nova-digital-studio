# ==========================================
# .gitignore base — NOVA Web
# Pensado para proyectos Astro / Next.js / Node
# ==========================================

# Dependencias
node_modules/
.pnpm-store/

# Builds y output
dist/
build/
.next/
out/
.astro/
.vercel/
.turbo/
.cache/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Sistema operativo
.DS_Store
Thumbs.db

# Editores / IDEs
.vscode/*
!.vscode/extensions.json
.idea/

# TypeScript
*.tsbuildinfo

# Testing / coverage
coverage/

# Archivos temporales
*.tmp
*.temp

# Herramientas de agentes IA (locales al entorno de desarrollo, no código del sitio)
.claude/
.agents/
.codex/
.impeccable/
skills-lock.json
