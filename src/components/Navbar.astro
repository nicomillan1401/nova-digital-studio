---
import { Menu, X } from '@lucide/astro';
import Button from './Button.astro';
import { navLinks } from '../data/site';
---

<!--
  Wordmark temporal: el logo definitivo de NOVA aún no está aprobado. Este
  es un wordmark tipográfico deliberadamente simple (Unbounded + punto en
  dorado), fácil de reemplazar por un logo real sin tocar el layout — el
  slot ocupa un `<a>` de altura fija, no una imagen con proporciones fijas.
-->
<header
  data-navbar
  class="border-cloud/10 bg-ground/70 fixed top-0 z-50 w-full border-b backdrop-blur-md"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 sm:px-8">
    <a
      href="#inicio"
      class="font-display text-cloud flex items-baseline text-xl font-bold tracking-tight"
    >
      NOVA<span class="text-gold-500">.</span>
    </a>

    <ul class="hidden items-center gap-9 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link text-cloud-muted hover:text-cloud font-sans text-sm"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden md:block">
      <Button href="#contacto" variant="ghost" size="sm"> Crear mi proyecto </Button>
    </div>

    <button
      data-menu-toggle
      type="button"
      class="interactive-lift group text-cloud inline-flex items-center justify-center rounded-md p-2 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu class="h-6 w-6 group-aria-expanded:hidden" />
      <X class="hidden h-6 w-6 group-aria-expanded:block" />
    </button>
  </nav>

  <div
    id="mobile-menu"
    data-mobile-menu
    class="border-cloud/10 bg-ground invisible absolute inset-x-0 top-full border-b px-6 pt-2 pb-6 opacity-0 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <li>
            <a data-mobile-link href={link.href} class="text-cloud block py-3 font-sans text-lg">
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-3">
        <Button data-mobile-link href="#contacto" variant="primary" size="md" class="w-full">
          Crear mi proyecto
        </Button>
      </li>
    </ul>
  </div>
</header>

<script>
  import { initNavbarMotion } from '../lib/motion/navbar';

  initNavbarMotion(document);
</script>
