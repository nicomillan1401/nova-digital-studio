---
import { AtSign, Mail, MessageCircle } from '@lucide/astro';
import { siteConfig, navLinks, floatingWhatsapp } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-cloud/10 bg-ground border-t">
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-10 sm:px-8 sm:pt-28">
    <div data-reveal-group class="grid gap-10 sm:grid-cols-[1.3fr_1fr_1fr]">
      <div data-reveal-item>
        <p class="text-cloud-muted font-sans text-sm">{siteConfig.description}</p>
      </div>

      <div data-reveal-item>
        <p class="text-cloud-muted font-mono text-xs tracking-[0.15em] uppercase">Navegación</p>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-cloud-muted hover:text-cloud font-sans text-sm">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal-item>
        <p class="text-cloud-muted font-mono text-xs tracking-[0.15em] uppercase">Contacto</p>
        <ul class="text-cloud-muted mt-4 space-y-3 font-sans text-sm">
          <li class="flex items-center gap-2">
            <Mail class="text-gold-500 h-4 w-4" />
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-cloud">
              {siteConfig.contact.email}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <MessageCircle class="text-gold-500 h-4 w-4" />
            <a
              href={floatingWhatsapp.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cloud"
            >
              {siteConfig.contact.whatsapp}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <AtSign class="text-gold-500 h-4 w-4" />
            <a
              href={siteConfig.contact.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-cloud"
            >
              {siteConfig.contact.instagramHandle}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!--
      Momento tipográfico de cierre: el wordmark gigante, apenas visible,
      como firma final del sitio — mismo recurso que el hero pero invertido
      (aquí se disuelve en el fondo en vez de aparecer con fuerza).
    -->
    <p
      data-reveal
      class="font-display text-cloud/[0.06] mt-20 text-center text-[clamp(3.5rem,16vw,11rem)] leading-none font-black tracking-tight select-none"
      aria-hidden="true"
    >
      NOVA
    </p>

    <div
      class="border-cloud/10 mt-10 flex flex-col items-center gap-2 border-t pt-6 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <p class="text-cloud-muted font-mono text-[11px] tracking-[0.08em] uppercase">
        {`© ${year} ${siteConfig.fullName}`}
      </p>
      <p class="text-cloud-muted font-mono text-[11px] tracking-[0.08em] uppercase">
        Web Design · Digital Studio
      </p>
    </div>
  </div>
</footer>
