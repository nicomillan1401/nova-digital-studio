---
import { Mail, Phone } from '@lucide/astro';
import { siteConfig, navLinks, whatsappLink } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-ink/10 bg-paper border-t">
  <div class="mx-auto max-w-6xl px-6 pt-20 pb-10 sm:px-8 sm:pt-28">
    <p data-reveal class="font-display text-ink text-4xl leading-none tracking-tight sm:text-6xl">
      {siteConfig.name}
    </p>

    <div data-reveal-group class="border-ink/10 mt-16 grid gap-10 border-t pt-10 sm:grid-cols-3">
      <div data-reveal-item>
        <p class="text-ink-muted max-w-xs font-sans text-sm">{siteConfig.description}</p>
      </div>

      <div data-reveal-item>
        <p class="text-ink-muted font-sans text-xs font-medium tracking-[0.15em] uppercase">
          Navegación
        </p>
        <ul class="mt-4 space-y-2">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="text-ink-muted hover:text-ink font-sans text-sm">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal-item>
        <p class="text-ink-muted font-sans text-xs font-medium tracking-[0.15em] uppercase">
          Contacto
        </p>
        <ul class="text-ink-muted mt-4 space-y-3 font-sans text-sm">
          <li class="flex items-center gap-2">
            <Mail class="text-accent-600 h-4 w-4" />
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-ink">
              {siteConfig.contact.email}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Phone class="text-accent-600 h-4 w-4" />
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
              {siteConfig.contact.whatsapp}
            </a>
          </li>
        </ul>
        <div class="mt-5 flex gap-3">
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="social-icon text-ink-muted hover:text-ink"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-5 w-5"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a
            href={siteConfig.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="social-icon text-ink-muted hover:text-ink"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-5 w-5"
            >
              <path d="M15 4h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-ink/10 border-t py-5">
    <p class="text-ink-muted text-center font-sans text-xs">
      {`© ${year} ${siteConfig.name}. Sitio construido por NOVA Web.`}
    </p>
  </div>
</footer>
