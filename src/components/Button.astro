---
/**
 * Botón reutilizable — 3 variantes pensadas para un sitio de fondo oscuro
 * por defecto. `magnetic` activa el hover magnético (ver
 * src/lib/motion/magnetic.ts): úsalo solo en 1-2 CTAs primarios.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'invert';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  magnetic?: boolean;
  /** Abre el enlace en una pestaña nueva (enlaces externos: WhatsApp, redes). */
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  magnetic = false,
  external = false,
  class: className = '',
} = Astro.props;

// rounded-none, no rounded-full: el pill button es la firma visual más
// reconocible de "plantilla de agencia/SaaS genérica" — el resto del
// sitio ya trabaja con bordes rectos (paneles, secciones, hairlines), así
// que el botón se alinea con esa misma estética editorial en vez de ser
// el único elemento redondeado del sitio.
const base =
  'interactive-lift inline-flex items-center justify-center gap-2 rounded-none font-sans font-semibold transition-[color,background-color,border-color] duration-150 ease-[var(--ease-out-strong)] active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500';

const variants = {
  primary: 'bg-gold-500 text-ground hover:bg-gold-400',
  ghost: 'border border-cloud/25 text-cloud hover:border-cloud/50',
  invert: 'bg-cloud text-ground hover:bg-gold-400',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-2.5 text-base',
  lg: 'px-7 py-3.5 text-base',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{
  href ? (
    <a
      href={href}
      class={classes}
      data-magnetic={magnetic ? '' : undefined}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} data-magnetic={magnetic ? '' : undefined}>
      <slot />
    </button>
  )
}
