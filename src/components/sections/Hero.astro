---
import Button from '../Button.astro';
import { hero } from '../../data/site';
---

<!--
  El hero es la tesis del sitio: tipografía como protagonista, sin imagen
  ni degradado de fondo. Un estudio digital demuestra su criterio con cómo
  trata el texto, no con un hero-shot genérico.
-->
<section id="inicio" class="relative overflow-hidden pt-36 pb-24 sm:pt-48 sm:pb-32">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgb(216_170_90_/_8%),transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 sm:px-8">
    <p
      data-hero-item
      class="text-gold-500 font-mono text-xs font-medium tracking-[0.22em] uppercase"
    >
      {hero.eyebrow}
    </p>

    <h1
      class="font-display text-cloud mt-6 text-[clamp(2.6rem,8.4vw,6.25rem)] leading-[0.98] font-bold tracking-tight"
    >
      {
        hero.headline.map((line) => (
          <span class="reveal-line-mask block">
            <span data-hero-line class="block">
              {line}
            </span>
          </span>
        ))
      }
    </h1>

    <p data-hero-item class="text-cloud-muted mt-8 max-w-xl font-sans text-lg sm:text-xl">
      {hero.sub}
    </p>

    <div data-hero-item class="mt-10 flex flex-wrap items-center gap-4">
      {
        hero.ctas.map((cta) => (
          <Button
            href={cta.href}
            variant={cta.variant}
            size="lg"
            magnetic={cta.variant === 'primary'}
            external={cta.external}
          >
            {cta.label}
          </Button>
        ))
      }
    </div>

    <div data-hero-item class="border-cloud/10 mt-16 flex flex-wrap gap-x-10 gap-y-3 border-t pt-6">
      {
        hero.meta.map((step) => (
          <span class="text-cloud-muted font-mono text-xs">
            <b class="text-cloud">{step.n}</b> {step.label}
          </span>
        ))
      }
    </div>
  </div>
</section>
