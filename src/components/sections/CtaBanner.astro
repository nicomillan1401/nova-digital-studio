---
import Button from '../Button.astro';
import { cta, whatsappLink } from '../../data/site';
---

<section id="contacto" class="bg-ink text-paper py-28 sm:py-40">
  <div class="mx-auto max-w-3xl px-6 text-center sm:px-8">
    <p data-reveal class="text-accent-400 font-sans text-xs font-medium tracking-[0.2em] uppercase">
      {cta.eyebrow}
    </p>
    <h2 data-reveal class="font-display mt-6 text-4xl tracking-tight sm:text-6xl">
      {cta.headline}
    </h2>
    <p data-reveal class="text-paper/70 mx-auto mt-6 max-w-md font-sans">
      {cta.sub}
    </p>
    <div data-reveal class="mt-10">
      <Button href={whatsappLink} variant="invert" size="lg" magnetic external>
        {cta.buttonLabel}
      </Button>
    </div>
  </div>
</section>
