---
import { studio } from '../../data/site';
---

{
  /*
    Momento memorable: puente de transición cinematográfico entre el navy
    del resto del sitio y el papel de Studio (initSectionScrub, scrub
    ligado al scroll, no un timer). Va en un div separado del contenido
    de texto —no en la propia section— para que ningún párrafo tenga que
    sostener contraste legible a mitad de una transición de color; el
    texto siempre vive sobre `bg-paper` sólido.
  */
}
<div data-scrub-bg aria-hidden="true" class="h-[18vh] sm:h-[26vh]"></div>

<!--
  Único respiro claro del sitio: rompe el ritmo navy a propósito — el
  momento más humano/reflexivo del sitio también se presenta literalmente
  distinto.
-->
<section id="studio" class="bg-paper text-ink">
  <div class="grid gap-12 px-6 py-16 sm:px-10 sm:py-24 lg:grid-cols-[1fr_1fr] lg:gap-16 lg:px-16">
    <div data-reveal>
      <!-- text-[oklch(...)] en vez de text-gold-700: a este tamaño de texto
           (xs) gold-700 da 4.27:1 sobre `paper`, por debajo del mínimo AA de
           4.5:1 para texto normal. Este tono más oscuro da 5.5:1. -->
      <p
        class="font-mono text-xs font-medium tracking-[0.2em] text-[oklch(0.50_0.15_68)] uppercase"
      >
        {studio.eyebrow}
      </p>
      <h2
        class="font-display text-ink mt-6 text-[clamp(1.8rem,3.6vw,2.75rem)] leading-[1.08] font-bold tracking-tight"
      >
        {studio.headline}
        <br />
        <span class="text-gold-700">{studio.headlineAccent}</span>
      </h2>
    </div>

    <div data-reveal-group class="flex flex-col gap-6">
      {
        studio.paragraphs.map((p) => (
          <p data-reveal-item class="text-ink-muted font-sans leading-relaxed">
            {p}
          </p>
        ))
      }
    </div>
  </div>

  {
    /*
      Pull-quote que rompe el ancho del contenedor de 2 columnas de
      arriba: tipografía gigante en vez de una cita pequeña metida en la
      columna de texto — el mismo dispositivo de contraste de escala que
      el resto del sitio, aplicado al único momento de calma tipográfica.
    */
  }
  <div class="border-ink/10 border-t px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
    <blockquote
      data-reveal
      class="font-display text-ink max-w-4xl text-[clamp(1.75rem,4.4vw,3.25rem)] leading-[1.1] font-medium tracking-tight italic"
    >
      “{studio.quote}”
    </blockquote>
  </div>
</section>
