---
import { marqueeWords } from '../../data/site';

// Duplicado exacto: la animación mueve translateX(-50%), las dos mitades
// deben ser idénticas para que el loop sea imperceptible.
const words = [...marqueeWords, ...marqueeWords];
---

<div class="border-cloud/10 bg-ground-raised overflow-hidden border-y py-4" aria-hidden="true">
  <div class="marquee-track">
    {
      words.map((word) => (
        <span class="flex shrink-0 items-center gap-8 pr-8 whitespace-nowrap">
          <span class="text-cloud-muted font-mono text-sm tracking-wide uppercase">{word}</span>
          <span class="text-gold-500">/</span>
        </span>
      ))
    }
  </div>
</div>
