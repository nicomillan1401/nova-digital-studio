---
import { process } from '../../data/site';
---

<section id="proceso" class="border-cloud/10 border-t">
  <div class="mx-auto max-w-6xl px-6 py-28 sm:px-8 sm:py-40">
    <div data-reveal class="max-w-xl">
      <p class="text-gold-500 font-mono text-xs font-medium tracking-[0.2em] uppercase">
        {process.eyebrow}
      </p>
      <h2
        class="font-display text-cloud mt-4 text-4xl leading-[1.02] font-bold tracking-tight sm:text-5xl"
      >
        {process.headline.map((line) => <span class="block">{line}</span>)}
      </h2>
    </div>

    <div data-progress-track class="relative mt-20">
      <div class="bg-cloud/10 absolute top-0 left-0 h-px w-full"></div>
      <div
        data-progress-fill
        class="bg-gold-500 absolute top-0 left-0 h-px w-full origin-left scale-x-0"
      >
      </div>

      <div data-reveal-group class="grid grid-cols-1 gap-12 pt-10 sm:grid-cols-4 sm:gap-8">
        {
          process.steps.map((step) => (
            <div data-reveal-item>
              <span class="text-gold-500 font-mono text-xs tracking-[0.08em]">{step.n}</span>
              <h3 class="font-display text-cloud mt-4 text-xl font-semibold">{step.title}</h3>
              <p class="text-cloud-muted mt-3 font-sans text-sm">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
