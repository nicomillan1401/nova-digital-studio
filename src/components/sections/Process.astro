---
import { process } from '../../data/site';
---

<!--
  Único caso del sitio donde 4 columnas iguales son la decisión correcta:
  esto SÍ es una secuencia real (4 pasos ordenados), no una lista genérica
  forzada a grid — la estructura simétrica encode información verdadera.
  La diferenciación viene del motion: cada numeral gana escala/color al
  cruzar el centro del viewport (initStepEmphasis), un índice editorial
  vivo en vez de cuatro etiquetas estáticas.
-->
<section id="proceso" class="border-cloud/10 border-t">
  <div class="px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
    <!--
      Sin eyebrow-tag: "Cómo trabajamos" era redundante con el propio H2
      ("Del 'tengo una idea' al 'ya está online'") — la etiqueta no
      agregaba información, solo repetía el mismo dispositivo visual de
      cada otra sección.
    -->
    <div data-reveal class="max-w-xl">
      <h2
        class="font-display text-cloud text-4xl leading-[1.02] font-bold tracking-tight sm:text-5xl"
      >
        {process.headline.map((line) => <span class="block">{line}</span>)}
      </h2>
    </div>

    <div data-progress-track class="relative mt-16">
      <div class="bg-cloud/10 absolute top-0 left-0 h-px w-full"></div>
      <div
        data-progress-fill
        class="bg-gold-500 absolute top-0 left-0 h-px w-full origin-left scale-x-0"
      >
      </div>

      <div data-reveal-group class="grid grid-cols-1 gap-12 pt-10 sm:grid-cols-4 sm:gap-8">
        {
          process.steps.map((step) => (
            <div data-reveal-item>
              <span
                data-step-numeral
                class="text-gold-500 inline-block origin-left font-mono text-2xl tracking-[0.04em]"
              >
                {step.n}
              </span>
              <h3 class="font-display text-cloud mt-4 text-xl font-semibold">{step.title}</h3>
              <p class="text-cloud-muted mt-3 font-sans text-sm">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
