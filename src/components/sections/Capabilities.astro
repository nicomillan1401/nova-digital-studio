---
import { capabilities } from '../../data/site';
---

<section class="border-ink/10 border-t">
  <div class="mx-auto max-w-6xl px-6 py-28 sm:px-8 sm:py-40">
    <div data-reveal class="max-w-xl">
      <p class="text-accent-600 font-sans text-xs font-medium tracking-[0.2em] uppercase">
        Qué hacemos
      </p>
      <h2 class="font-display text-ink mt-4 text-4xl tracking-tight sm:text-5xl">Capacidades</h2>
    </div>

    <div data-reveal-group class="divide-ink/10 border-ink/10 mt-16 divide-y border-t">
      {
        capabilities.map((cap) => (
          <div
            data-reveal-item
            class="group grid grid-cols-1 gap-3 py-8 sm:grid-cols-[3rem_1fr_2fr] sm:items-baseline sm:gap-10"
          >
            <span class="font-display text-ink-muted text-lg">{cap.n}</span>
            <h3 class="font-display text-ink group-hover:text-accent-600 text-2xl transition-colors duration-150">
              {cap.title}
            </h3>
            <p class="text-ink-muted font-sans sm:text-right">{cap.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
