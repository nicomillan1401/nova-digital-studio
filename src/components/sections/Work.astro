---
import { work } from '../../data/site';

const [first, second] = work.experiments;
---

<!--
  Reescritura completa (no ajuste) de la composición anterior: fuera el
  mockup de navegador, el ícono de categoría y la tarjeta flotante con
  borde — todo eso es ADN de "case study template" de portfolio dev.

  Dos composiciones deliberadamente distintas (no espejadas) por
  proyecto: la 01 es un banner horizontal full-bleed con el numeral y el
  título integrados/superpuestos a la propia imagen; la 02 es vertical y
  asimétrica, desplazada a la derecha, con el numeral viviendo en el
  espacio negativo FUERA de la imagen — el contraste entre ambas es la
  variación real, no una plantilla de card repetida dos veces.

  Sin CTA ni botón en esta sección: es puramente visual/editorial, sin
  nada que compita con la composición ni simule ser clickeable (no son
  casos reales, ver `work.intro` arriba).
-->
<section id="trabajo" class="border-cloud/10 border-t">
  <div class="px-6 pt-24 sm:px-10 sm:pt-32 lg:px-16">
    <div
      data-reveal
      class="border-cloud/10 flex flex-wrap items-end justify-between gap-4 border-b pb-8"
    >
      <div class="max-w-2xl">
        <p class="text-gold-500 font-mono text-xs font-medium tracking-[0.2em] uppercase">
          {work.eyebrow}
        </p>
        <h2
          class="font-display text-cloud mt-4 text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl"
        >
          {work.headline.map((line) => <span class="block">{line}</span>)}
        </h2>
        <p class="text-cloud-muted mt-4 font-sans">{work.intro}</p>
      </div>
    </div>
  </div>

  {
    /* PROYECTO 01 — banner horizontal full-bleed: numeral con contorno y
       título gigante viven dentro/sobre la propia imagen, no en una card
       aparte. Zoom-out continuo (data-work-scale) da sensación de
       profundidad al centrarse en pantalla. */
  }
  <div class="bleed-x relative mt-16 sm:mt-20">
    <div data-work-panel class="relative aspect-[4/3] w-full overflow-hidden sm:aspect-[21/9]">
      <div
        data-work-scale
        class="experiment-panel experiment-panel--gold absolute inset-0 flex items-end justify-end p-4 sm:p-8"
      >
        <span
          data-work-numeral
          class="numeral-outline numeral-outline--gold text-[clamp(7rem,26vw,16rem)]"
        >
          {first.n}
        </span>
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-[linear-gradient(to_top,var(--color-ground),transparent)]"
      >
      </div>
    </div>

    <!--
      Sin margen negativo (solape) por debajo de `sm`: el panel es mucho
      más bajo en mobile (aspect 4/3 vs 21/9) y el título ocupa todo el
      ancho, así que un solape calibrado para el banner ancho de
      escritorio choca directamente contra el numeral en la esquina del
      panel — se detectó así, con "RESTAURANTE" tapado por el numeral.
    -->
    <div class="relative z-10 mt-6 px-6 sm:-mt-28 sm:px-10 lg:px-16">
      <p data-work-tag class="text-gold-500 font-mono text-xs tracking-[0.14em] uppercase">
        Concepto — {first.n}
      </p>
      <!--
        break-words + mínimo del clamp bajado a 2.1rem (no 2.5rem): con
        una sola palabra larga sin espacio ("RESTAURANTE"), el texto
        desbordaba su propio contenedor por ~20px en mobile, y el
        `overflow-x: hidden` de body (necesario para .bleed-x) lo
        recortaba en el borde del viewport — cortando media "E" final y
        dejando algo que se leía como "RESTAURANTI". Como esta sección
        debe funcionar con nombres reales de clientes de longitud
        desconocida, break-words es la red de seguridad permanente, no
        solo un ajuste puntual para esta palabra.
      -->
      <h3
        data-work-title
        class="font-display text-cloud mt-2 text-[clamp(2.1rem,9vw,6.5rem)] leading-[0.86] font-bold tracking-tight break-words uppercase"
      >
        {first.category}
      </h3>
      <p class="text-cloud-muted mt-5 max-w-md font-sans text-sm sm:text-base">
        {first.description}
      </p>
    </div>
  </div>

  {
    /* PROYECTO 02 — composición vertical, desplazada a la derecha; el
       numeral vive fuera de la imagen, en el espacio negativo a la
       izquierda — asimetría real frente al proyecto 01, no un espejo. */
  }
  <div class="px-6 pt-28 pb-24 sm:px-10 sm:pt-36 sm:pb-32 lg:px-16">
    <div
      class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.4fr)] lg:items-center lg:gap-10"
    >
      <div class="relative">
        <span
          data-work-numeral
          class="numeral-outline numeral-outline--cloud text-[clamp(6rem,18vw,11rem)]"
        >
          {second.n}
        </span>
        <p
          data-work-tag
          class="text-gold-500 mt-2 font-mono text-xs tracking-[0.14em] uppercase lg:mt-6"
        >
          Concepto — {second.n}
        </p>
        <h3
          data-work-title
          class="font-display text-cloud mt-2 text-3xl leading-[0.95] font-bold tracking-tight break-words uppercase sm:text-4xl"
        >
          {second.category}
        </h3>
        <p class="text-cloud-muted mt-4 max-w-sm font-sans text-sm">{second.description}</p>
      </div>

      <div
        data-work-panel
        class="relative aspect-[4/5] w-full overflow-hidden sm:aspect-[3/4] lg:max-w-md lg:justify-self-end"
      >
        <div data-work-scale class="experiment-panel experiment-panel--raised absolute inset-0">
        </div>
      </div>
    </div>
  </div>
</section>
